# Supabase (project: aichi-nagoya26-observations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JavaScript API key (billing-enabled Google Cloud project).
# Without this, the dashboard map shows a placeholder but everything else works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Shared passcode gate for the whole site (submission form + dashboard).
# Leave both blank during local dev to disable the gate.
SITE_PASSCODE=
SESSION_SECRET=
